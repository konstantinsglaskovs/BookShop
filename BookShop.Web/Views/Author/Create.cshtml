@model BookShop.Web.Models.Authors.CreateAuthorViewModel

@{
    ViewData["Title"] = "Add author";
}

<div class="page-header">
    <h1 class="page-title">Add author</h1>

    <p class="page-description">
        Add a new author to the catalog.
    </p>
</div>

<div class="card form-card">

    <form asp-controller="Author"
          asp-action="Create"
          method="post"
          class="form-stack">

        <div class="form-group">

            <label asp-for="Name"
                   class="form-label">
            </label>

            <input asp-for="Name"
                   class="form-control"
                   placeholder="Author name" />

            <span asp-validation-for="Name"
                  class="field-validation-error">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="Bio"
                   class="form-label">
                Biography
            </label>

            <textarea asp-for="Bio"
                      class="form-control"
                      placeholder="Short author biography...">
            </textarea>

            <span asp-validation-for="Bio"
                  class="field-validation-error">
            </span>

        </div>

        <div class="actions">

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-lg"></i>
                Save
            </button>

            <a asp-controller="Author"
               asp-action="Index"
               class="btn btn-secondary">

                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
