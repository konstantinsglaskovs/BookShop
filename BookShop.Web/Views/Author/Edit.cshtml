@model BookShop.Web.Models.Authors.UpdateAuthorViewModel

@{
    ViewData["Title"] = "Edit author";
}

<div class="page-header">
    <h1 class="page-title">Edit author</h1>

    <p class="page-description">
        Update author information.
    </p>
</div>

<div class="card form-card">

    <form asp-controller="Author"
          asp-action="Edit"
          method="post"
          class="form-stack">

        <input asp-for="Id"
               type="hidden" />

        <div class="form-group">

            <label asp-for="Name"
                   class="form-label">
            </label>

            <input asp-for="Name"
                   class="form-control" />

            <span asp-validation-for="Name"
                  class="field-validation-error">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="Bio"
                   class="form-label">
                Biography
            </label>

            <textarea asp-for="Bio"
                      class="form-control">
            </textarea>

            <span asp-validation-for="Bio"
                  class="field-validation-error">
            </span>

        </div>

        <div class="actions">

            <button type="submit"
                    class="btn btn-success">

                <i class="bi bi-check-lg"></i>
                Save changes
            </button>

            <a asp-controller="Author"
               asp-action="Index"
               class="btn btn-secondary">

                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}