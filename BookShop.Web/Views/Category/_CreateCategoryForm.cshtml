@model BookShop.Web.Models.Categories.CreateCategoryViewModel

<form asp-controller="Category" asp-action="Create" method="post" class="inline-form">

    <div class="form-group">

        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control"
               placeholder="For example: Fantasy" />

        <span asp-validation-for="Name"
              class="field-validation-error">
        </span>

    </div>

    <div class="form-group">
        <label class="form-label form-label--hidden">
            Action
        </label>

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Add category
        </button>
    </div>

</form>
