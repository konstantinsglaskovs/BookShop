@using BookShop.Domain.Enums
@using BookShop.Web.Models.Checkout
@model CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/checkout.css"
          asp-append-version="true" />
}

<div class="page-header">
    <h1 class="page-title">Checkout</h1>

    <p class="page-description">
        Enter your delivery information and review your order.
    </p>
</div>

<div asp-validation-summary="ModelOnly"
     class="validation-summary-errors">
</div>

<form asp-controller="Checkout"
      asp-action="Create"
      method="post"
      class="checkout-layout">

    <div class="checkout-form">

        <div class="card form-card">
            <h2 class="form-section-title">
                Recipient
            </h2>

            <div class="form-stack">

                <div class="checkout-row">
                    <div class="form-group">
                        <label asp-for="RecipientName"
                               class="form-label">
                            Name
                        </label>

                        <input asp-for="RecipientName"
                               class="form-control" />

                        <span asp-validation-for="RecipientName"
                              class="field-validation-error">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RecipientSurname"
                               class="form-label">
                            Surname
                        </label>

                        <input asp-for="RecipientSurname"
                               class="form-control" />

                        <span asp-validation-for="RecipientSurname"
                              class="field-validation-error">
                        </span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber"
                           class="form-label">
                        Phone number
                    </label>

                    <input asp-for="PhoneNumber"
                           class="form-control" />

                    <span asp-validation-for="PhoneNumber"
                          class="field-validation-error">
                    </span>
                </div>

            </div>
        </div>

        <div class="card form-card">
            <h2 class="form-section-title">
                Delivery address
            </h2>

            <div class="form-stack">

                <div class="form-group">
                    <label asp-for="StreetAddress"
                           class="form-label">
                        Street address
                    </label>

                    <input asp-for="StreetAddress"
                           class="form-control" />

                    <span asp-validation-for="StreetAddress"
                          class="field-validation-error">
                    </span>
                </div>

                <div class="checkout-row">
                    <div class="form-group">
                        <label asp-for="City"
                               class="form-label">
                            City
                        </label>

                        <input asp-for="City"
                               class="form-control" />

                        <span asp-validation-for="City"
                              class="field-validation-error">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="State"
                               class="form-label">
                            State / Region
                        </label>

                        <input asp-for="State"
                               class="form-control" />

                        <span asp-validation-for="State"
                              class="field-validation-error">
                        </span>
                    </div>
                </div>

                <div class="checkout-row">
                    <div class="form-group">
                        <label asp-for="PostalCode"
                               class="form-label">
                            Postal code
                        </label>

                        <input asp-for="PostalCode"
                               class="form-control" />

                        <span asp-validation-for="PostalCode"
                              class="field-validation-error">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Country"
                               class="form-label">
                            Country
                        </label>

                        <select asp-for="Country"
                                class="form-select"
                                asp-items="Html.GetEnumSelectList<Country>()">
                        </select>

                        <span asp-validation-for="Country"
                              class="field-validation-error">
                        </span>
                    </div>
                </div>

            </div>
        </div>

    </div>


    <aside class="card checkout-summary">

        <h2 class="checkout-summary__title">
            Order summary
        </h2>

        <div class="checkout-summary__items">

            @foreach (var item in Model.Cart.Items)
            {
                <div class="checkout-summary__item">

                    <div>
                        <div class="checkout-summary__item-title">
                            @item.Title
                        </div>

                        <div class="checkout-summary__item-quantity">
                            @item.Quantity ×
                            €@item.Price.ToString("0.00")
                        </div>
                    </div>

                    <div class="checkout-summary__item-price">
                        €@item.Subtotal.ToString("0.00")
                    </div>

                </div>
            }

        </div>

        <div class="checkout-summary__divider"></div>

        <div class="checkout-summary__total">
            <span>Total</span>

            <span>
                €@Model.Cart.Total.ToString("0.00")
            </span>
        </div>

        <button type="submit"
                class="btn btn-primary checkout-summary__pay">
            Proceed to payment
        </button>

        <a asp-controller="Cart"
           asp-action="Index"
           class="checkout-summary__back">
            Back to cart
        </a>

    </aside>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}