@model Guid

@{
    ViewData["Title"] = "Payment successful";
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/checkout.css"
          asp-append-version="true" />
}

<div class="card checkout-success">

    <div class="checkout-success__icon">
        <i class="bi bi-check-circle-fill"></i>
    </div>

    <h1 class="checkout-success__title">
        Payment successful
    </h1>

    <p class="checkout-success__text">
        Your payment has been completed successfully.
        Your order is now being processed.
    </p>

    <div class="checkout-success__order">
        Order ID:
        <strong>@Model</strong>
    </div>

    <div class="checkout-success__actions">

        <a asp-controller="Book"
           asp-action="Index"
           class="btn btn-primary">
            Continue shopping
        </a>

    </div>

</div>