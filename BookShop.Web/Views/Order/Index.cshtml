@using BookShop.Application.Orders.Users.Dtos
@model List<UserOrderListItemDto>

@{
    ViewData["Title"] = "My orders";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/order.css"
          asp-append-version="true" />
}

<div class="page-header">
    <h1 class="page-title">My orders</h1>

    <p class="page-description">
        View your order history and current order status.
    </p>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-circle"></i>
        @error
    </div>
}

@if (Model.Count == 0)
{
    <div class="card order-empty">

        <i class="bi bi-bag order-empty__icon"></i>

        <h2>No orders yet</h2>

        <p>
            Your orders will appear here after checkout.
        </p>

        <a asp-controller="Book"
           asp-action="Index"
           class="btn btn-primary">
            Browse books
        </a>

    </div>
}
else
{
    <div class="card order-list-card">

        <div class="table-responsive">

            <table class="order-table">

                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var order in Model)
                    {
                        <tr>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="order-table__id">
                                    #@order.Id.ToString()[..8]
                                </a>
                            </td>

                            <td class="order-table__date">
                                @(order.OrderDate
                                    .ToLocalTime()
                                    .ToString("dd.MM.yyyy HH:mm"))
                            </td>

                            <td>
                                @order.ItemsCount
                            </td>

                            <td class="order-table__total">
                                €@order.Total.ToString("0.00")
                            </td>

                            <td>
                                <span class="order-badge
                                    order-badge--@order.OrderStatus.ToString().ToLowerInvariant()">
                                    @order.OrderStatus
                                </span>
                            </td>

                            <td>
                                <span class="payment-badge
                                    payment-badge--@order.PaymentStatus.ToString().ToLowerInvariant()">
                                    @order.PaymentStatus
                                </span>
                            </td>

                            <td class="order-table__actions">
                                <a asp-action="Details"
                                   asp-route-id="@order.Id"
                                   class="btn btn-secondary btn-sm">
                                    Details
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}