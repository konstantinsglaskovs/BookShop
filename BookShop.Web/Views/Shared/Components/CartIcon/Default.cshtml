@model int

<a asp-controller="Cart"
   asp-action="Index"
   class="header-cart"
   title="Cart">

    @if (Model > 0)
    {
        <i class="bi bi-cart-fill"></i>

        <span class="header-cart__count">
            @Model
        </span>
    }
    else
    {
        <i class="bi bi-cart3"></i>
    }

</a>
