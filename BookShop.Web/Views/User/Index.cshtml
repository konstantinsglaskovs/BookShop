@using BookShop.Application.UserManagement.Dtos
@model List<UserListItemDto>

@{
    ViewData["Title"] = "Users";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/user.css"
          asp-append-version="true" />
}

<div class="page-header">
    <div>
        <h1 class="page-title">Users</h1>
        <p class="page-description">
            Manage user roles and account access.
        </p>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">
        @success
    </div>
}

<form method="get"
      asp-controller="User"
      asp-action="Index"
      class="user-search">

    <input type="text"
           name="search"
           value="@ViewBag.Search"
           class="form-control"
           placeholder="Search by email, name or surname..." />

    <button type="submit"
            class="btn btn-primary">
        <i class="bi bi-search"></i>
        Search
    </button>

    @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string))
    {
        <a asp-controller="User"
           asp-action="Index"
           class="btn btn-secondary">
            Clear
        </a>
    }

</form>

<div class="card user-table-card">

    @if (Model.Count == 0)
    {
        <div class="user-empty">
            No users found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table user-table">

                <thead>
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th class="user-actions-column">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>

                            <td>
                                <div class="user-name">
                                    <div class="user-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>

                                    <div>
                                        <strong>
                                            @user.Name @user.Surname
                                        </strong>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @user.Email
                            </td>

                            <td>

                                <form asp-controller="User"
                                      asp-action="ChangeRole"
                                      method="post"
                                      class="user-role-form">

                                    <input type="hidden"
                                           name="userId"
                                           value="@user.Id" />

                                    <select name="role"
                                            class="form-control user-role-select">

                                        @if (user.Role == "User")
                                        {
                                            <option value="User" selected>
                                                User
                                            </option>

                                            <option value="Admin">
                                                Admin
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="User">
                                                User
                                            </option>

                                            <option value="Admin" selected>
                                                Admin
                                            </option>
                                        }

                                    </select>

                                    <button type="submit"
                                            class="btn btn-secondary btn-sm">
                                        Save
                                    </button>

                                </form>

                            </td>

                            <td>
                                @if (user.IsLocked)
                                {
                                    <span class="user-status user-status--locked">
                                        <i class="bi bi-lock-fill"></i>
                                        Locked
                                    </span>
                                }
                                else
                                {
                                    <span class="user-status user-status--active">
                                        <i class="bi bi-check-circle-fill"></i>
                                        Active
                                    </span>
                                }
                            </td>

                            <td class="user-actions">

                                <form asp-controller="User"
                                      asp-action="SetLock"
                                      method="post">

                                    <input type="hidden"
                                           name="userId"
                                           value="@user.Id" />

                                    @if (user.IsLocked)
                                    {
                                        <button type="submit"
                                                name="locked"
                                                value="false"
                                                class="btn btn-secondary btn-sm">
                                            <i class="bi bi-unlock"></i>
                                            Unblock
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                name="locked"
                                                value="true"
                                                class="btn btn-danger btn-sm">
                                            <i class="bi bi-lock"></i>
                                            Block
                                        </button>
                                    }

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>